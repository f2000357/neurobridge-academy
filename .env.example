# Copy to .env (local) or set these in your host's dashboard.
# Never commit real values — .env* is gitignored.

# --- Required ---

# Postgres. Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the DIRECT connection (port 5432) for `prisma db push`; switch to the
# pooled one (port 6543, ?pgbouncer=true&connection_limit=1) for serverless runtime.
DATABASE_URL="postgresql://postgres:<DB-PASSWORD>@db.<project-ref>.supabase.co:5432/postgres"

# Anthropic API key — powers weekly planning, the IEP review, and report import.
ANTHROPIC_API_KEY="sk-ant-..."

# Signs the session cookie. MUST be set in production: without it the app falls
# back to a known dev string, which would let anyone forge a session.
# Generate one:  openssl rand -base64 32
SESSION_SECRET="replace-me-with-32-random-bytes"


# --- Optional ---

# (removed) DEMO_SWITCH no longer exists. Password-free account switching is
# local-development only and cannot be enabled on a production build — see
# lib/demo.ts. Delete this variable from any host that still sets it.

# --- Email (optional until you're sending) ---

# Resend API key. Without it nothing is sent: the app hands the link back on
# screen instead, so every flow still works. https://resend.com
RESEND_API_KEY=""

# The From address. The domain must be verified with your provider or mail lands
# in spam (or is rejected outright).
EMAIL_FROM="NeuroBridge <hello@neurobridge-academy.com>"

# Absolute base URL used to build links inside emails. On Vercel this is derived
# automatically; set it locally or to pin a custom domain.
APP_URL="https://neurobridge-academy.com"
