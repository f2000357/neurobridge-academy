# Copy to .env (local) or set these in your host's dashboard.
# Never commit real values — .env* is gitignored.

# --- Required ---

# Postgres. Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the DIRECT connection (port 5432) for `prisma db push`; switch to the
# pooled one (port 6543, ?pgbouncer=true&connection_limit=1) for serverless runtime.
DATABASE_URL="postgresql://postgres:<DB-PASSWORD>@db.<project-ref>.supabase.co:5432/postgres"

# Anthropic API key — powers weekly planning, the IEP review, and report import.
ANTHROPIC_API_KEY="sk-ant-..."

# Signs the session cookie. MUST be set in production: without it the app falls
# back to a known dev string, which would let anyone forge a session.
# Generate one:  openssl rand -base64 32
SESSION_SECRET="replace-me-with-32-random-bytes"


# --- Optional ---

# Password-free account switching ("switch" in the top bar).
# Always on locally. On a HOSTED build it only appears when this is exactly "1".
# While set, anyone with the URL can enter any account — use seeded demo data
# only, never a real child's records. Unset it when the demos are over.
DEMO_SWITCH="1"
