generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A learning center (tenant). Guides and learners belong to a center; the
// NeuroBridge company sits above all centers.
model Center {
  id          String       @id @default(cuid())
  name        String
  region      String       @default("")
  createdAt   DateTime     @default(now())
  users       User[]
  children    Child[]
  lessonPlans LessonPlan[]
}

// An operator account. role decides scope:
//   neurable_admin — the company, spans all centers (centerId null)
//   center_admin   — runs one center
//   guide          — teaches a roster of learners (the homeschool parent)
model User {
  id          String       @id @default(cuid())
  name        String
  email       String?      @unique
  role        String       @default("guide") // neurable_admin | center_admin | guide
  centerId    String?
  center      Center?      @relation(fields: [centerId], references: [id])
  // Real login: scrypt hash ("salt:hash"). Empty means no password set yet, so
  // the account can't sign in until an initial one is issued.
  passwordHash String      @default("")
  pin         String       @default("2468") // parental gate to exit a child's locked session
  ixlUrl      String       @default("") // guide's own IXL account link (a reference, not credentials)
  children    Child[]      // learners this user guides (role=guide)
  lessonPlans LessonPlan[] // lessons this user authored
  rewards     Reward[]
}

// Audit trail for admin-level actions (learner transfers, lesson promotions).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String   // transfer_learner | promote_lesson | create_user | create_center
  detail    String   @default("")
  createdAt DateTime @default(now())
}

// A prize the guide offers in exchange for points (school or home reward).
model Reward {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  cost      Int                          // points needed to redeem
  emoji     String   @default("🎁")
  active    Boolean  @default(true)       // hidden from the shelf when false
  createdAt DateTime @default(now())
  redemptions Redemption[]
}

// A record of a child spending points on a prize (guide-assisted). Immutable log.
model Redemption {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  rewardId   String?
  reward     Reward?  @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  rewardName String                       // snapshot so history survives catalog edits
  emoji      String   @default("🎁")
  cost       Int                          // points spent
  createdAt  DateTime @default(now())
}

model Child {
  id        String         @id @default(cuid())
  // The learner's current guide — a reassignable pointer. Switching guides is a
  // one-field change; all the learner's data below is keyed to childId, not this.
  teacherId String
  teacher   User           @relation(fields: [teacherId], references: [id])
  // Optional: a pure homeschool parent has no center. Association with a center
  // happens later through a separate intake process.
  centerId  String?
  center    Center?        @relation(fields: [centerId], references: [id])
  name      String
  username  String?        @unique // friendly URL handle, e.g. "paiyer" for Prithvi Aiyer
  age       Int?
  accessCode String        @default("") // 8-digit code the child enters at their own link
  archived  Boolean        @default(false) // deactivated: hidden from rosters, no learner access
  // Which standards framework this learner is held to (see lib/standards.ts).
  standardsCode String     @default("NJ")
  // The grade the learner is enrolled in / expected to be at ("K", "1" … "12").
  // They may be working below it — the weekly planner treats this as the TARGET
  // and deliberately closes the gap as fast as the child can sustain.
  gradeLevel String        @default("")
  // Which content providers this learner has (CSV of ids). IXL is the only
  // integrated platform today — it has a crawlable, standards-aligned catalog.
  // Kept as a CSV so a second provider can be added later without a migration.
  providers  String        @default("ixl")
  // When this child's school day starts (minutes from midnight). The day always
  // ends at 3:00pm; some families start later. 540 = 9:00, 570 = 9:30, 600 = 10:00.
  dayStartMin Int          @default(540)
  points    Int            @default(0) // lifetime points collected (never goes down)
  pointsSpent Int          @default(0) // total redeemed on prizes; balance = points - pointsSpent
  pointEvents PointEvent[]
  homework    Homework[]
  weeklyPlans WeeklyPlan[]
  absences    Absence[]
  weeklyTests WeeklyTest[]
  redemptions Redemption[]
  interestBlocks ChildInterest[]
  // The "IEP for the AI" — everything the AI must know to serve this child.
  profile   ChildProfile?
  slots     ScheduleSlot[]
  sessions  Session[]
  documents ChildDocument[]
  proposals ProgramProposal[]
  specialists TeacherAssignment[]
  teacherNotes TeacherNote[]
  assessmentImports AssessmentImport[]
  providerCompletions ProviderCompletion[]
  iepReviews IepReview[]
  assessmentPlans AssessmentPlan[]
}

// A provider lesson (IXL) the child did off-platform and marked done. The
// work happens outside, so the guide validates it: they open the child's work on
// the provider (practiceUrl), read the accuracy, and enter it — coins = floor(
// accuracy / 10), 0-10. Points stay native: we never import the provider's score.
model ProviderCompletion {
  id           String    @id @default(cuid())
  childId      String
  child        Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  slotId       String?
  title        String    @default("")
  provider     String    @default("")
  practiceUrl  String    @default("") // deep link the guide opens to check the work
  accuracy     Int?      // % the guide read off the provider
  coins        Int       @default(0) // floor(accuracy/10); awarded on validation
  status       String    @default("pending") // pending | validated | rejected
  pointEventId String?   // the award, so an undo can reverse it
  createdAt    DateTime  @default(now())
  validatedAt  DateTime?
}

// A practice/assessment report (IXL, MAP) the guide exported and uploaded.
// The AI reads the file and pulls out where the child needs work; those focus
// areas feed the next week's plan. Content stays on the provider — this is only
// the results coming back.
model AssessmentImport {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  provider  String   @default("ixl") // ixl | map
  weekStart String   @default("")    // the Monday this import informs
  summary   String   @default("")    // one-line overall read
  focus     String   @default("[]")  // JSON [{lane, subject, skill, questionsMissed}]
  mastery   String   @default("{}")  // JSON per-lane mastery snapshot
  createdAt DateTime @default(now())
}

// An IEP review the parent generated: the AI reads the child's IEP, the school's
// progress report, and the MAP scores, and drafts what's working, what isn't,
// where to focus, and new "asks" to bring to the IEP team. A preparation aid —
// never legal advice. Kept as history so parents can compare across IEP cycles.
model IepReview {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  result    String   @default("{}") // JSON: {standing, goals[], goingWell[], concerns[], focus[], asks[]}
  docCount  Int      @default(0)    // how many documents fed it
  // Fingerprint of the documents used — regeneration is blocked unless this
  // changes (a new IEP or MAP). Generating is compute-expensive.
  signature String   @default("")
  // A NeuroBridge admin can archive old reviews to free the per-child cap.
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// An external assessment (MAP, IXL diagnostic, an achievement test…) the family
// plans, registers for, and takes OFF-platform. We hold the plan and the result;
// the test itself always happens on the provider's own site.
model AssessmentPlan {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  testId    String   // id from the catalog in lib/assessments.ts
  status    String   @default("planned") // planned | registered | taken | skipped
  testDate  String   @default("")        // when it's booked / was taken (YYYY-MM-DD)
  score     String   @default("")        // as reported, e.g. "Math RIT 198 (42nd %ile)"
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A special interest the family wants protected time for each week.
// "2 sessions x 2 slots" = twice a week, two 30-minute blocks each.
model ChildInterest {
  id              String   @id @default(cuid())
  childId         String
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  activity        String   // an id from ELECTIVES in lib/activities.ts
  sessionsPerWeek Int      @default(1)
  slotsPerSession Int      @default(1)
  backToBack      Boolean  @default(true) // keep a session's slots contiguous
  createdAt       DateTime @default(now())

  @@unique([childId, activity])
}

// Uploaded source material (IEP, strengths list, evaluation, …). The AI reads
// these to propose a program; the guide approves or rejects it.
model ChildDocument {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  kind      String   @default("other") // iep | strengths | evaluation | other
  data      String   // base64-encoded file bytes
  createdAt DateTime @default(now())
}

// An AI-proposed program the guide reviews. Each lesson is approved or rejected.
model ProgramProposal {
  id        String           @id @default(cuid())
  childId   String
  child     Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  summary   String           @default("")
  createdAt DateTime         @default(now())
  lessons   ProposedLesson[]
}

model ProposedLesson {
  id           String          @id @default(cuid())
  proposalId   String
  proposal     ProgramProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  subject      String
  grade        String          @default("")
  topic        String          @default("")
  standardCode String          @default("")
  title        String
  rationale    String          @default("")
  source       String          @default("document") // document | advancement
  status       String          @default("pending") // pending | approved | rejected
  lessonPlanId String?         // set when approved and materialized into a LessonPlan
}

// Teacher marks a child absent for a day (skips their work; testing carries over).
model Absence {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  createdAt DateTime @default(now())

  @@unique([childId, date])
}

// The Friday standardized check-in. Its per-subject scores drive next week's plan.
model WeeklyTest {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  weekStart String   // Monday of the week this test informs
  takenOn   String   // date actually taken
  scores    String   @default("{}") // JSON: { "Math": 72, "ELA — Reading": 65, … }
  createdAt DateTime @default(now())

  @@unique([childId, weekStart])
}

// A per-child week plan the AI proposes and the guide reviews at week start.
// Layer 1 (subject/flexible blocks) comes from the schedule; this is Layer 2:
// each subject gets a focus + a difficulty ramp across the week's blocks.
model WeeklyPlan {
  id        String        @id @default(cuid())
  childId   String
  child     Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  weekStart String                                // Monday, "YYYY-MM-DD"
  status    String        @default("proposed")    // proposed | approved
  createdAt DateTime      @default(now())
  lessons   WeeklyLesson[]

  @@unique([childId, weekStart])
}

model WeeklyLesson {
  id           String     @id @default(cuid())
  planId       String
  plan         WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  slotId       String     // the schedule block this lesson fills
  subject      String
  focus        String     @default("") // the subject's weekly focus
  date         String
  startMin     Int
  order        Int        // position in the subject's weekly ramp (0-based)
  level        Int        @default(1) // difficulty step (1 = start of week … higher = harder)
  topic        String     @default("")
  standardCode String     @default("")
  title        String
  rationale    String     @default("")
  status       String     @default("pending") // pending | approved | rejected
  lessonPlanId String?    // set once materialized into a real LessonPlan
}

// Weekly homework: a 10-question worksheet generated when a skill is mastered,
// due the next Monday. Lives in the child's Homework folder.
model Homework {
  id           String   @id @default(cuid())
  childId      String
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  title        String
  subject      String   @default("")
  topic        String   @default("")
  standardCode String   @default("")
  questions    String   // JSON: [{question, answer}] × 10
  dueDate      String   // "YYYY-MM-DD" — a Monday
  status       String   @default("assigned") // assigned | completed
  score        Int?
  createdAt    DateTime @default(now())
}

model ChildProfile {
  id      String @id @default(cuid())
  childId String @unique
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  // Communication
  readingLevel   String @default("grade-3") // working level, e.g. "grade-3" (adjusted from MAP)
  mathLevel      String @default("")        // working math level, e.g. "grade-3" (adjusted from MAP)
  sentenceStyle  String @default("short")   // short | medium | rich
  literalLanguage Boolean @default(true)    // avoid idioms/figurative speech
  interests      String @default("")        // comma-separated, used in examples

  // Assessment inputs used to build a customized program.
  iepNotes       String @default("")        // IEP goals / recent evaluation summary
  mapTerm        String @default("")        // e.g. "Fall 2025"
  mapReadingRit  Int?                        // NWEA MAP RIT scores
  mapMathRit     Int?
  mapLanguageRit Int?

  // Sensory & visual
  calmView      Boolean @default(false)
  textScale     Float   @default(1.0)
  soundOn       Boolean @default(true)
  reducedMotion Boolean @default(false)

  // Executive functioning supports
  groundingStyle    String @default("standard") // brief | standard | extended
  timerStyle        String @default("bar")      // bar | sand | none
  transitionWarnMin Int    @default(2)
  firstThenVisible  Boolean @default(true)

  // Pacing & regulation
  pacing          String @default("gentle")  // gentle | steady | brisk
  practiceBatch   Int    @default(1)         // questions shown at a time
  frustrationPlan String @default("offer-break") // offer-break | easier-step | breathing
  neverDo         String @default("")        // hard rules for the AI, plain text
}

model LessonPlan {
  id        String         @id @default(cuid())
  // The author of this lesson.
  teacherId String
  teacher   User           @relation(fields: [teacherId], references: [id])
  // Which center owns it (for center-shared browsing). Null for global lessons.
  centerId  String?
  center    Center?        @relation(fields: [centerId], references: [id])
  // Who can find & reuse it: private (author + the child's current guide) |
  // center (same-center guides) | global (all centers).
  visibility String        @default("private")
  // A guide can nominate a center lesson for the global shelf; an admin promotes it.
  submittedForGlobal Boolean @default(false)
  // If this lesson was copied from a shared one, the source id (provenance).
  copiedFromId String?
  // Customized program: a plan designed for one child. Null = shared library plan,
  // still personalized at delivery time via the child's profile.
  childId   String?
  title     String
  subject   String
  // Curriculum organization (NJ Student Learning Standards).
  gradeLevel   String       @default("") // "K", "1" … "12"
  topic        String       @default("") // strand/domain, e.g. "Fractions"
  standardCode String       @default("") // e.g. "3.NF.A.1"
  standardText String       @default("") // human-readable standard description
  goal      String
  whyItMatters String      @default("")
  // Optional link to practice on an external tool (e.g. an IXL skill URL). A pointer
  // only — no points or completion are tracked from it.
  workUrl   String         @default("")
  // Ordered chunk list: video | visual | read_text | worksheet | wrap_up (JSON)
  chunks    String
  durationMin Int          @default(25)
  renderer  String         @default("web") // "web" now; "xr" later for Quest lessons
  published Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  slots     ScheduleSlot[]
  assets       LessonAsset[]
}

model ScheduleSlot {
  id           String      @id @default(cuid())
  childId      String
  child        Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  lessonPlanId String?
  lessonPlan   LessonPlan? @relation(fields: [lessonPlanId], references: [id])
  kind         String      @default("lesson") // lesson | one_on_one | flexible | break | free_time | testing | service
  // For a mandatory Education (lesson) block: which subject it is (math | reading
  // | writing | science …), set when the day template is laid down — BEFORE any
  // lesson content is attached. Once a lessonPlan is linked, its subject wins.
  subject      String      @default("")
  // For flexible periods (an elective) or related services (speech, OT…):
  // which activity this block actually is. See lib/activities.ts.
  activity     String      @default("")
  date         String                          // "2026-07-21" (local date)
  startMin     Int                             // minutes from midnight, e.g. 540 = 9:00
  endMin       Int
  // A visiting specialist can hold this block — "Chess with Ravi". Blank means
  // the guide runs it.
  teacherId    String?
  sessions     Session[]
  teacherNotes TeacherNote[]
}

// One run of the EF loop. A slot can host several runs: the scheduled one,
// plus child-chosen relaunches or guided replays during flexible periods.
model Session {
  id            String       @id @default(cuid())
  slotId        String
  slot          ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  childId       String
  child         Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  origin        String       @default("scheduled") // scheduled | relaunch | guided_replay
  state         String       @default("arrived") // arrived | grounded | delivering | checking | closed
  chunkProgress String       @default("[]")      // JSON: per-chunk completion
  transcript    String       @default("[]")      // JSON: tutor conversation
  // Adaptive engine: full progress snapshot for resume + points + no-abandon.
  resumeData    String       @default("")        // JSON: {phase, stepIdx, round, qNum, questions, answers, pointsEarned}
  pointsEarned  Int          @default(0)
  advancedLevel Int          @default(0)          // how far into Advanced mode
  abandoned     Boolean      @default(false)      // guide abandoned this lesson
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  signals       EvalSignal[]
  progressNote  ProgressNote?
  pointEvents   PointEvent[]
}

// Immutable record of points earned — the auditable history.
model PointEvent {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  points    Int
  kind      String   @default("core") // core | challenge | advanced
  date      String                     // "2026-07-22" (local) for per-day totals
  createdAt DateTime @default(now())
}

// Ambient continuous evaluation — every interaction is a signal.
model EvalSignal {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chunkIndex Int
  kind      String   // answer | simplify_request | replay | time_on_task | break | frustration_cue
  payload   String   @default("{}") // JSON detail (e.g. correct/incorrect, attempt #)
  createdAt DateTime @default(now())
}

// AI-written report the teacher reads: what worked / where stuck / next step.
model ProgressNote {
  id           String  @id @default(cuid())
  sessionId    String  @unique
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workedWell   String  @default("")
  stuckOn      String  @default("")
  nextStep     String  @default("")
  teacherNotes String  @default("")
  // Assessment result: every class ends graded.
  score        Int?    // percent correct on the closing assessment, 0-100
  masteryLevel String  @default("") // struggling | approaching | proficient
  createdAt    DateTime @default(now())
}

// A visiting specialist: a chess coach, a piano teacher, a math tutor, an SLP.
// Not an operator account — no dashboard, no password. They hold one code that
// works for every learner they are assigned to, and it is their identity: the
// code says who is writing. Only NeuroBridge admin can ever read it back; everyone
// else adds a teacher and the code goes to the teacher directly.
model SpecialistTeacher {
  id          String              @id @default(cuid())
  email       String              @unique // the identity key — one profile per person
  name        String
  phone       String              @default("")
  specialty   String              @default("misc") // see SPECIALTIES in lib/specialists.ts
  code        String              @unique // "T" + 8 digits — never shown outside NeuroBridge admin
  // Whoever added them. Anyone may: a center admin, or a homeschool parent who
  // hired a piano teacher. It does not restrict who can assign them later.
  createdById String
  createdByName String            @default("")
  archived    Boolean             @default(false)
  // Has the code actually reached them yet? Email/SMS delivery is not built,
  // so this stays false and NeuroBridge admin works the pending list by hand.
  codeSentAt  DateTime?
  createdAt   DateTime            @default(now())
  assignments TeacherAssignment[]
  notes       TeacherNote[]
}

// The grant. Delete it and the learner disappears from the teacher's roster —
// notes they already wrote stay, because those are the learner's record.
model TeacherAssignment {
  id        String            @id @default(cuid())
  teacherId String
  teacher   SpecialistTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  childId   String
  child     Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  subject   String            @default("") // what they teach THIS learner; blank = their specialty
  createdAt DateTime          @default(now())

  @@unique([teacherId, childId])
}

// What the specialist writes after a session. Never shown to the learner;
// visible to the guide, the center, NeuroBridge admin, and the child's other
// specialists. Feeds the progress report.
model TeacherNote {
  id            String            @id @default(cuid())
  childId       String
  child         Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       SpecialistTeacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // The block it is about, when there is one. A specialist who met the learner
  // off-schedule still gets to write the note.
  slotId        String?
  slot          ScheduleSlot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)
  date          String            // "YYYY-MM-DD" — the day being written about
  subject       String            @default("")
  whatWeDid     String            @default("")
  wentWell      String            @default("")
  struggledWith String            @default("")
  nextTime      String            @default("")
  focus         Int? // 1-5, optional: how settled the learner was
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  media         TeacherMedia[]
}

// A photo or short video attached to a note — the finished painting, the swim
// stroke, three minutes of the piano piece. Bytes live on disk under .uploads;
// the database keeps only the pointer.
model TeacherMedia {
  id        String      @id @default(cuid())
  noteId    String
  note      TeacherNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  kind      String      @default("image") // image | video
  bytes     Int         @default(0)
  path      String // relative to the uploads root
  caption   String      @default("")
  createdAt DateTime    @default(now())
}

// An image the guide added to a lesson while previewing it — a diagram, a photo
// of a worked example, a picture that makes the idea land. Teaching material,
// not a record about a child. Bytes on disk, pointer here.
model LessonAsset {
  id         String     @id @default(cuid())
  lessonId   String
  lesson     LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  bytes      Int        @default(0)
  path       String // relative to the uploads root
  createdAt  DateTime   @default(now())
}

// The content index: state standard → provider skill (with deep links). Built
// from the providers' published standards-alignment pages and refreshed on a
// schedule. This is what makes a "lesson" the right IXL skill for where the
// child stands — deterministic deep links, no AI-invented URLs.
model ContentItem {
  id           String   @id @default(cuid())
  provider     String   // ixl
  framework    String   @default("NJ") // standards framework (see lib/standards.ts)
  standardCode String   // e.g. 3.OA.C.7
  subject      String   // math | reading | writing | science
  gradeLevel   String   // "K".."12"
  skillName    String
  skillCode    String   @default("") // the provider's short code, if any
  videoUrl     String   @default("")  // deep link to the skill's video
  practiceUrl  String   @default("")  // deep link to the skill's practice
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([provider, standardCode, practiceUrl])
  @@index([framework, standardCode])
  @@index([provider, subject, gradeLevel])
}
